# Copié en docker/.env sur le VPS (jamais commité). Les secrets se génèrent avec `openssl rand -hex 32`.

# --- API ---
DATABASE_URL=postgresql://churchy_user:CHANGE_ME@postgres-central:5432/churchy?schema=public
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Web et API sur la même origine (nginx route /api vers l'API) : pas de CORS ni de cookie cross-host.
FRONTEND_URL=https://churchy.tigilabs.com
# Un seul reverse proxy (nginx) devant l'API : l'IP cliente vient de X-Forwarded-For.
TRUST_PROXY_HOPS=1
AUTH_THROTTLE_LIMIT=10
# Le rendu serveur du web appelle l'API depuis une seule IP Docker : seuil élevé.
THROTTLE_LIMIT=3000
# Connexion Google : ID client OAuth (public). Vide = Google désactivé et bouton masqué. Origine autorisée : le domaine du site.
GOOGLE_CLIENT_ID=
# Poivre des PIN (obligatoire en production, 32 car. min.) : openssl rand -hex 32. Ne JAMAIS le perdre ni le changer
# sans prévenir : tous les PIN enregistrés avec lui deviendraient invalides (réinitialisation de chaque PIN).
PIN_PEPPER=

# --- Web (inlinée au build) ---
NEXT_PUBLIC_API_URL=https://churchy.tigilabs.com/api
# URL publique du site : sitemap, hreflang, aperçus (changer au changement de domaine, puis rebuild).
NEXT_PUBLIC_SITE_URL=https://churchy.tigilabs.com

# --- Notifications (worker d'emails) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true pour le port 465 (TLS implicite), false pour 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Churchy <no-reply@tigilabs.com>"
CONTACT_EMAIL=contact@tigilabs.com
# SMS : « log » (rien n'est envoyé) tant qu'aucun contrat opérateur (Orange, MTN) n'est branché.
SMS_PROVIDER=log

# --- Infra ---
UPLOADS_ROOT=/home/ubuntu/uploads/churchy
NGINX_NETWORK=proxy
