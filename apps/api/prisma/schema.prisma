generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  USER
}

enum ParishRole {
  PARISH_ADMIN
  PREPARER
  READER
  VIEWER
}

enum ContentType {
  SONG
  PSALM
  GOSPEL
  READING
  PRAYER
  UNIVERSAL_PRAYER
  ANNOUNCEMENT
  FREE_TEXT
}

enum CelebrationType {
  SUNDAY_MASS
  WEEKDAY_MASS
  WEDDING
  BAPTISM
  FUNERAL
  OTHER
}

enum CelebrationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  firstName       String
  lastName        String
  role            UserRole  @default(USER)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  refreshTokens        RefreshToken[]
  authTokens           AuthToken[]
  parishMembers        ParishMember[]
  createdContents      Content[]
  createdCelebrations  Celebration[]
  createdAnnouncements Announcement[]
  createdActivities    Activity[]
}

/// Jeton de rafraîchissement (stocké haché). `familyId` regroupe les jetons issus d'une même
/// connexion : la réutilisation d'un jeton déjà révoqué révoque toute la famille.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

enum AuthTokenType {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

/// Jeton à usage unique (réinitialisation de mot de passe, vérification d'email), stocké haché.
model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model Parish {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  city        String
  country     String
  /// Quartier, pour la recherche publique.
  district    String?
  address     String?
  /// Nom de l'église principale.
  mainChurch  String?
  phone       String?
  email       String?
  website     String?
  /// Photo ou identité visuelle (URL).
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members              ParishMember[]
  contents             Content[]
  celebrationTemplates CelebrationTemplate[]
  celebrations         Celebration[]
  announcements        Announcement[]
  activities           Activity[]

  @@index([city])
}

model ParishMember {
  id        String     @id @default(cuid())
  userId    String
  parishId  String
  role      ParishRole @default(VIEWER)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  parish Parish @relation(fields: [parishId], references: [id], onDelete: Cascade)

  @@unique([userId, parishId])
}

model Content {
  id          String      @id @default(cuid())
  parishId    String
  title       String
  type        ContentType
  body        String      @db.Text
  language    String      @default("fr")
  tags        String[]
  createdById String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  parish    Parish @relation(fields: [parishId], references: [id], onDelete: Cascade)
  createdBy User   @relation(fields: [createdById], references: [id])

  celebrationSteps CelebrationStep[]
}

model CelebrationTemplate {
  id          String          @id @default(cuid())
  parishId    String
  name        String
  type        CelebrationType
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  parish       Parish                    @relation(fields: [parishId], references: [id], onDelete: Cascade)
  steps        CelebrationTemplateStep[]
  celebrations Celebration[]
}

model CelebrationTemplateStep {
  id                  String       @id @default(cuid())
  templateId          String
  title               String
  key                 String
  order               Int
  expectedContentType ContentType?
  isRequired          Boolean      @default(true)

  template         CelebrationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  celebrationSteps CelebrationStep[]

  @@unique([templateId, key])
  @@unique([templateId, order])
}

model Celebration {
  id          String            @id @default(cuid())
  parishId    String
  templateId  String
  title       String
  date        DateTime
  location    String?
  status      CelebrationStatus @default(DRAFT)
  /// Annoncée au public avant la publication de la feuille (« feuille en préparation »).
  announced   Boolean           @default(false)
  createdById String
  publishedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  parish    Parish              @relation(fields: [parishId], references: [id], onDelete: Cascade)
  template  CelebrationTemplate @relation(fields: [templateId], references: [id])
  createdBy User                @relation(fields: [createdById], references: [id])
  steps     CelebrationStep[]

  @@index([parishId, date])
}

model CelebrationStep {
  id             String  @id @default(cuid())
  celebrationId  String
  templateStepId String
  title          String
  order          Int
  contentId      String?
  customText     String? @db.Text

  celebration  Celebration             @relation(fields: [celebrationId], references: [id], onDelete: Cascade)
  templateStep CelebrationTemplateStep @relation(fields: [templateStepId], references: [id])
  content      Content?                @relation(fields: [contentId], references: [id])
}

/// Annonce de la paroisse, publiée dès sa création.
model Announcement {
  id          String   @id @default(cuid())
  parishId    String
  title       String
  summary     String?
  body        String   @db.Text
  imageUrl    String?
  createdById String
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parish    Parish @relation(fields: [parishId], references: [id], onDelete: Cascade)
  createdBy User   @relation(fields: [createdById], references: [id])

  @@index([parishId, publishedAt])
}

/// Activité ou événement de la paroisse (rencontre, retraite, pèlerinage…).
model Activity {
  id          String   @id @default(cuid())
  parishId    String
  title       String
  description String   @db.Text
  startsAt    DateTime
  location    String?
  imageUrl    String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parish    Parish @relation(fields: [parishId], references: [id], onDelete: Cascade)
  createdBy User   @relation(fields: [createdById], references: [id])

  @@index([parishId, startsAt])
}
