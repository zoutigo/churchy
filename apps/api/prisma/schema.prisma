generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  USER
}

enum ParishRole {
  PARISH_ADMIN
  PREPARER
  READER
  VIEWER
}

enum ContentType {
  SONG
  PSALM
  GOSPEL
  READING
  PRAYER
  UNIVERSAL_PRAYER
  ANNOUNCEMENT
  FREE_TEXT
}

enum CelebrationType {
  SUNDAY_MASS
  WEEKDAY_MASS
  WEDDING
  BAPTISM
  FUNERAL
  OTHER
}

enum CelebrationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  firstName       String
  lastName        String
  role            UserRole  @default(USER)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  refreshTokens        RefreshToken[]
  authTokens           AuthToken[]
  parishMembers        ParishMember[]
  favoriteParishes     FavoriteParish[]
  createdContents      Content[]
  createdCelebrations  Celebration[]
  createdAnnouncements Announcement[]
  createdActivities    Activity[]
}

/// Jeton de rafraîchissement (stocké haché). `familyId` regroupe les jetons issus d'une même
/// connexion : la réutilisation d'un jeton déjà révoqué révoque toute la famille.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

enum AuthTokenType {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

/// Jeton à usage unique (réinitialisation de mot de passe, vérification d'email), stocké haché.
model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model Parish {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  description       String?
  city              String
  country           String
  /// Région (Cameroun : liste fermée côté interface).
  region            String?
  /// Quartier, pour la recherche publique.
  district          String?
  address           String?
  /// Indication pour retrouver l'église (« en face de la poste centrale »).
  addressComplement String?
  /// Nom de l'église principale.
  mainChurch        String?
  phone             String?
  email             String?
  website           String?
  /// Photo ou identité visuelle (URL).
  imageUrl          String?
  /// Fuseau horaire IANA : les heures des célébrations sont des heures locales de ce fuseau.
  timezone          String   @default("Europe/Paris")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  members              ParishMember[]
  favoritedBy          FavoriteParish[]
  contents             Content[]
  celebrationTemplates CelebrationTemplate[]
  celebrations         Celebration[]
  occurrences          CelebrationOccurrence[]
  announcements        Announcement[]
  activities           Activity[]

  @@index([city])
}

model ParishMember {
  id        String     @id @default(cuid())
  userId    String
  parishId  String
  role      ParishRole @default(VIEWER)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  parish Parish @relation(fields: [parishId], references: [id], onDelete: Cascade)

  @@unique([userId, parishId])
}

model Content {
  id          String      @id @default(cuid())
  parishId    String
  title       String
  type        ContentType
  body        String      @db.Text
  language    String      @default("fr")
  tags        String[]
  createdById String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  parish    Parish @relation(fields: [parishId], references: [id], onDelete: Cascade)
  createdBy User   @relation(fields: [createdById], references: [id])

  celebrationSteps CelebrationStep[]
}

model CelebrationTemplate {
  id          String          @id @default(cuid())
  parishId    String
  name        String
  type        CelebrationType
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  parish     Parish                    @relation(fields: [parishId], references: [id], onDelete: Cascade)
  steps      CelebrationTemplateStep[]
  sheets     PreparationSheet[]
  defaultFor Celebration[]             @relation("DefaultTemplate")
}

model CelebrationTemplateStep {
  id                  String       @id @default(cuid())
  templateId          String
  title               String
  key                 String
  order               Int
  expectedContentType ContentType?
  isRequired          Boolean      @default(true)

  template         CelebrationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  celebrationSteps CelebrationStep[]

  @@unique([templateId, key])
  @@unique([templateId, order])
}

/// Série de célébrations (ex. « Messe du dimanche ») : informations communes à toutes ses dates.
model Celebration {
  id                String          @id @default(cuid())
  parishId          String
  title             String
  type              CelebrationType
  location          String?
  /// Description publique (HTML nettoyé).
  description       String?         @db.Text
  /// Note interne à l'équipe de préparation : jamais exposée au public.
  internalNote      String?         @db.Text
  /// Visible du public (toutes les dates). Les feuilles restent « en préparation » jusqu'à leur publication.
  announced         Boolean         @default(false)
  /// Modèle de feuille proposé par défaut pour les dates de la série.
  defaultTemplateId String?
  archivedAt        DateTime?
  createdById       String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  parish          Parish                  @relation(fields: [parishId], references: [id], onDelete: Cascade)
  defaultTemplate CelebrationTemplate?    @relation("DefaultTemplate", fields: [defaultTemplateId], references: [id], onDelete: SetNull)
  createdBy       User                    @relation(fields: [createdById], references: [id])
  occurrences     CelebrationOccurrence[]

  @@index([parishId, announced])
}

enum OccurrenceStatus {
  SCHEDULED
  CANCELLED
}

/// Une date d'une série. Le passé est immuable (contrôlé par l'API).
model CelebrationOccurrence {
  id            String           @id @default(cuid())
  celebrationId String
  /// Dupliqué de la série pour les index et les contrôles d'accès.
  parishId      String
  startsAt      DateTime
  /// Précision publique propre à cette date (ex. « l'évêque sera là »).
  description   String?          @db.Text
  /// Note interne propre à cette date (ex. point de vigilance pour la préparation).
  internalNote  String?          @db.Text
  status        OccurrenceStatus @default(SCHEDULED)
  cancelReason  String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  celebration Celebration       @relation(fields: [celebrationId], references: [id], onDelete: Cascade)
  parish      Parish            @relation(fields: [parishId], references: [id], onDelete: Cascade)
  sheet       PreparationSheet?

  @@unique([celebrationId, startsAt])
  @@index([parishId, startsAt])
}

/// Feuille de préparation d'une date : créée à la demande, depuis un modèle ou à la volée (sans modèle).
model PreparationSheet {
  id           String            @id @default(cuid())
  occurrenceId String            @unique
  /// Modèle d'origine (null = feuille construite à la volée).
  templateId   String?
  status       CelebrationStatus @default(DRAFT)
  publishedAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  occurrence CelebrationOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  template   CelebrationTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  steps      CelebrationStep[]
}

/// Étape d'une feuille. `key` permet de rapprocher les étapes quand on change de modèle.
model CelebrationStep {
  id             String  @id @default(cuid())
  sheetId        String
  templateStepId String?
  key            String
  title          String
  order          Int
  contentId      String?
  customText     String? @db.Text

  sheet        PreparationSheet         @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  templateStep CelebrationTemplateStep? @relation(fields: [templateStepId], references: [id], onDelete: SetNull)
  content      Content?                 @relation(fields: [contentId], references: [id])

  @@unique([sheetId, key])
}

/// Annonce de la paroisse, publiée dès sa création.
model Announcement {
  id          String   @id @default(cuid())
  parishId    String
  title       String
  summary     String?
  body        String   @db.Text
  imageUrl    String?
  createdById String
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parish    Parish @relation(fields: [parishId], references: [id], onDelete: Cascade)
  createdBy User   @relation(fields: [createdById], references: [id])

  @@index([parishId, publishedAt])
}

/// Activité ou événement de la paroisse (rencontre, retraite, pèlerinage…).
model Activity {
  id          String   @id @default(cuid())
  parishId    String
  title       String
  description String   @db.Text
  startsAt    DateTime
  location    String?
  imageUrl    String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parish    Parish @relation(fields: [parishId], references: [id], onDelete: Cascade)
  createdBy User   @relation(fields: [createdById], references: [id])

  @@index([parishId, startsAt])
}

/// Paroisse mise en favori par un utilisateur connecté (aucun droit : simple raccourci).
model FavoriteParish {
  userId    String
  parishId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  parish Parish @relation(fields: [parishId], references: [id], onDelete: Cascade)

  @@id([userId, parishId])
  @@index([userId, createdAt])
}
