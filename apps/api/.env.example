DATABASE_URL="postgresql://postgres:password@localhost:5433/churchy_db?schema=public"
# OBLIGATOIRE : pas de valeur de secours. Générer avec `openssl rand -hex 32` (16 caractères minimum).
JWT_SECRET="change-me-generate-with-openssl-rand-hex-32"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PORT=3201
NODE_ENV=development
# Origine du site web : CORS (avec cookies) et liens envoyés par email
FRONTEND_URL=http://localhost:3200
# Limites par minute et par IP (routes d'authentification sensibles / reste de l'API)
AUTH_THROTTLE_LIMIT=10
THROTTLE_LIMIT=120
# ID client OAuth Google (public) : active « Continuer avec Google ». Vide = désactivé.
GOOGLE_CLIENT_ID=
# Poivre des PIN (32 car. min., openssl rand -hex 32). Facultatif en dev, obligatoire en production.
PIN_PEPPER=
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0
