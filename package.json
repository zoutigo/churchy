{
  "name": "churchy",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e --concurrency=1",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:sync": "node scripts/agent-docs.mjs sync",
    "precommit": "node scripts/agent-docs.mjs check && lint-staged && npm run typecheck && npm test && npm run infra:up && npm run test:e2e -w @churchy/api",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.9",
    "turbo": "^2.1.0",
    "typescript-eslint": "^8.71.0"
  },
  "packageManager": "npm@10.9.3"
}
